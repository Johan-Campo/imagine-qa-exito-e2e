{
  "name": "imagine-qa-exito-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for exito.com built with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report",
    "test:sample": "playwright test --config playwright.sample.config.ts",
    "test:sample:report": "playwright show-report reports/sample-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "triage": "node --env-file=.env tools/failure-triage/triage.ts",
    "triage:eval": "node --env-file=.env tools/failure-triage/evaluate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
